#!/usr/bin/env bash
#
# Thin /btbai ship wrapper for this client repository.
#
# Common release mechanics live in btoddb/btb-pipeline/scripts/btb-ship-base.
# This wrapper keeps ha-music's manifest-based version selection and delegates
# commit/tag/release mechanics to the shared base command.
#
# Usage:
#   scripts/ship --version v1.2.3        # pre-release; set manifest version explicitly
#   scripts/ship --set-version v1.2.3    # same as --version
#   scripts/ship --bump-patch            # pre-release; increment manifest X.Y.(Z+1)
#   scripts/ship --bump-minor            # pre-release; increment manifest X.(Y+1).0
#   scripts/ship --bump-major            # pre-release; increment manifest (X+1).0.0
#   scripts/ship --public-release --set-version v1.2.3
#                                         # full release; label: latest, title: <tag>
#   scripts/ship --dry-run --bump-patch  # print release actions, change nothing
#
set -euo pipefail

COMPONENT_INSTALL_DIR=btoddb_ha_music

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PIPELINE_ROOT="${BTB_PIPELINE_ROOT:-$REPO_ROOT/.btb-pipeline}"
BASE_SHIP="$PIPELINE_ROOT/scripts/btb-ship-base"
MANIFEST="$REPO_ROOT/custom_components/${COMPONENT_INSTALL_DIR}/manifest.json"

BUMP=""
VERSION_TAG=""
VERSION_SET=false
BASE_ARGS=()

die() {
    echo "ship: $*" >&2
    exit 1
}

usage() {
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
}

set_version_option() {
    if "$VERSION_SET"; then
        echo "ship: choose only one version option" >&2
        exit 2
    fi
    VERSION_TAG="v${1#v}"
    VERSION_SET=true
}

set_bump_option() {
    if "$VERSION_SET"; then
        echo "ship: choose only one version option" >&2
        exit 2
    fi
    BUMP="$1"
    VERSION_SET=true
}

manifest_version() {
    jq -r '.version // empty' "$MANIFEST"
}

next_version() {
    local current major minor patch

    current="$(manifest_version)"
    if [[ ! "$current" =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
        die "manifest version '$current' is invalid - must be 'v' followed by exactly 3 dot-separated integers (e.g. v1.2.3)"
    fi

    major="${BASH_REMATCH[1]}"
    minor="${BASH_REMATCH[2]}"
    patch="${BASH_REMATCH[3]}"

    case "$1" in
        patch) printf 'v%s.%s.%s\n' "$major" "$minor" "$((10#$patch + 1))" ;;
        minor) printf 'v%s.%s.0\n' "$major" "$((10#$minor + 1))" ;;
        major) printf 'v%s.0.0\n' "$((10#$major + 1))" ;;
        *) die "unknown bump type '$1'" ;;
    esac
}

ensure_base_ship() {
    if [[ -x "$BASE_SHIP" ]]; then
        return
    fi

    if [[ -n "${BTB_PIPELINE_ROOT:-}" ]]; then
        echo "ship: expected executable base ship command at $BASE_SHIP" >&2
        echo "ship: BTB_PIPELINE_ROOT is set, so fix that checkout or unset it to use .btb-pipeline." >&2
        exit 1
    fi

    if [[ -e "$PIPELINE_ROOT" && ! -d "$PIPELINE_ROOT/.git" ]]; then
        echo "ship: $PIPELINE_ROOT exists but is not a btb-pipeline git checkout." >&2
        echo "ship: remove it or set BTB_PIPELINE_ROOT to a checkout containing scripts/btb-ship-base." >&2
        exit 1
    fi

    if [[ -d "$PIPELINE_ROOT/.git" ]]; then
        echo "Updating local btb-pipeline checkout at $PIPELINE_ROOT ..."
        git -C "$PIPELINE_ROOT" fetch --quiet --depth 1 --force origin refs/tags/v1:refs/tags/v1
        git -C "$PIPELINE_ROOT" checkout --quiet v1
    else
        echo "Fetching btb-pipeline@v1 into $PIPELINE_ROOT ..."
        git clone --quiet --config advice.detachedHead=false --depth 1 --branch v1 \
            https://github.com/btoddb/btb-pipeline.git \
            "$PIPELINE_ROOT"
    fi

    if [[ ! -x "$BASE_SHIP" ]]; then
        echo "ship: expected executable base ship command at $BASE_SHIP after fetching btb-pipeline@v1" >&2
        exit 1
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --version | --set-version)
            option="$1"
            shift
            if [[ $# -eq 0 || "${1:-}" == --* ]]; then
                echo "ship: $option requires a value (e.g. $option v1.2.3)" >&2
                exit 2
            fi
            set_version_option "$1"
            ;;
        --version=* | --set-version=*)
            set_version_option "${1#*=}"
            ;;
        --bump-patch)
            set_bump_option patch
            ;;
        --bump-minor)
            set_bump_option minor
            ;;
        --bump-major)
            set_bump_option major
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            BASE_ARGS+=("$1")
            ;;
    esac
    shift
done

if ! "$VERSION_SET"; then
    die "choose a version option: --version vX.Y.Z, --set-version vX.Y.Z, --bump-patch, --bump-minor, or --bump-major"
fi

if [[ -n "$BUMP" ]]; then
    VERSION_TAG="$(next_version "$BUMP")"
    echo "Using next $BUMP version from manifest.json: $VERSION_TAG"
else
    echo "Using explicit version: $VERSION_TAG"
fi

if [[ ! "$VERSION_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    die "version tag '$VERSION_TAG' is invalid - must be 'v' followed by exactly 3 dot-separated integers (e.g. v1.2.3)"
fi

ensure_base_ship

exec "$BASE_SHIP" \
    --repo-root "$REPO_ROOT" \
    --set-version "$VERSION_TAG" \
    "${BASE_ARGS[@]}"
